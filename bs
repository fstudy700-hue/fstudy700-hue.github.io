<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>FA-I Chapter 1 | Exam Prep</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=DM+Sans:wght@300;400;500;600&family=DM+Mono:wght@400;500&display=swap');

  :root {
    --bg: #0d0f1a;
    --surface: #13162a;
    --card: #1a1e35;
    --border: #252a45;
    --gold: #f5c842;
    --gold-dim: #a8893a;
    --green: #3ddc84;
    --red: #ff5f6d;
    --blue: #5b8dee;
    --text: #e8eaf6;
    --muted: #8b90b8;
    --accent: #7c3aed;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    font-family: 'DM Sans', sans-serif;
    background: var(--bg);
    color: var(--text);
    min-height: 100vh;
    line-height: 1.7;
  }

  /* HEADER */
  header {
    background: linear-gradient(135deg, #1a1e35 0%, #0d0f1a 100%);
    border-bottom: 1px solid var(--border);
    padding: 24px 20px;
    text-align: center;
    position: sticky;
    top: 0;
    z-index: 100;
    backdrop-filter: blur(10px);
  }

  header h1 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(1.4rem, 4vw, 2rem);
    color: var(--gold);
    letter-spacing: 1px;
  }

  header p {
    color: var(--muted);
    font-size: 0.85rem;
    margin-top: 4px;
  }

  .score-bar {
    display: flex;
    justify-content: center;
    gap: 20px;
    margin-top: 10px;
    font-size: 0.85rem;
  }

  .score-item { color: var(--muted); }
  .score-item span { font-weight: 600; }
  .score-item .correct { color: var(--green); }
  .score-item .wrong { color: var(--red); }
  .score-item .pending { color: var(--gold); }

  /* NAV TABS */
  .tabs {
    display: flex;
    overflow-x: auto;
    gap: 0;
    background: var(--surface);
    border-bottom: 1px solid var(--border);
    scrollbar-width: none;
  }
  .tabs::-webkit-scrollbar { display: none; }

  .tab {
    flex-shrink: 0;
    padding: 14px 22px;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--muted);
    cursor: pointer;
    border-bottom: 2px solid transparent;
    transition: all 0.2s;
    white-space: nowrap;
    background: none;
    border-left: none;
    border-right: none;
    border-top: none;
  }

  .tab:hover { color: var(--text); }
  .tab.active { color: var(--gold); border-bottom-color: var(--gold); }

  /* SECTIONS */
  .section { display: none; padding: 20px 16px; max-width: 900px; margin: 0 auto; }
  .section.active { display: block; }

  /* NOTES SECTION */
  .chapter-title {
    font-family: 'Playfair Display', serif;
    font-size: 1.6rem;
    color: var(--gold);
    margin-bottom: 6px;
  }

  .chapter-sub {
    color: var(--muted);
    font-size: 0.85rem;
    margin-bottom: 24px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--border);
  }

  .topic {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 12px;
    margin-bottom: 16px;
    overflow: hidden;
  }

  .topic-header {
    padding: 16px 20px;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    user-select: none;
  }

  .topic-header:hover { background: rgba(245,200,66,0.04); }

  .topic-title {
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--gold);
  }

  .topic-arrow {
    color: var(--muted);
    transition: transform 0.25s;
    font-size: 1.1rem;
  }

  .topic.open .topic-arrow { transform: rotate(180deg); }

  .topic-body {
    display: none;
    padding: 0 20px 20px;
    border-top: 1px solid var(--border);
  }

  .topic.open .topic-body { display: block; }

  .def-term {
    font-family: 'DM Mono', monospace;
    font-size: 0.8rem;
    color: var(--gold);
    background: rgba(245,200,66,0.08);
    border-left: 3px solid var(--gold);
    padding: 4px 10px;
    border-radius: 0 6px 6px 0;
    margin: 16px 0 6px;
    display: inline-block;
  }

  .def-body {
    font-size: 0.9rem;
    color: var(--text);
    line-height: 1.75;
    margin-bottom: 10px;
  }

  .bullet-list {
    list-style: none;
    padding: 0;
  }

  .bullet-list li {
    position: relative;
    padding-left: 18px;
    font-size: 0.875rem;
    color: var(--text);
    margin-bottom: 6px;
    line-height: 1.65;
  }

  .bullet-list li::before {
    content: '▸';
    position: absolute;
    left: 0;
    color: var(--gold-dim);
  }

  .compare-table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 14px;
    font-size: 0.82rem;
  }

  .compare-table th {
    background: rgba(245,200,66,0.12);
    color: var(--gold);
    padding: 10px 14px;
    text-align: left;
    font-weight: 600;
    border: 1px solid var(--border);
  }

  .compare-table td {
    padding: 9px 14px;
    border: 1px solid var(--border);
    color: var(--text);
    vertical-align: top;
    line-height: 1.5;
  }

  .compare-table tr:nth-child(even) td { background: rgba(255,255,255,0.02); }

  .highlight-box {
    background: rgba(91,141,238,0.08);
    border: 1px solid rgba(91,141,238,0.25);
    border-radius: 8px;
    padding: 14px 16px;
    margin: 14px 0;
    font-size: 0.875rem;
    color: var(--text);
  }

  .highlight-box strong { color: var(--blue); }

  .formula-box {
    background: rgba(245,200,66,0.06);
    border: 1px dashed var(--gold-dim);
    border-radius: 8px;
    padding: 14px 16px;
    margin: 14px 0;
    font-family: 'DM Mono', monospace;
    font-size: 0.875rem;
    color: var(--gold);
    text-align: center;
    letter-spacing: 0.5px;
  }

  .cycle-diagram {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 14px 0;
    justify-content: center;
  }

  .cycle-step {
    background: rgba(124,58,237,0.15);
    border: 1px solid rgba(124,58,237,0.35);
    border-radius: 8px;
    padding: 8px 14px;
    font-size: 0.8rem;
    color: var(--text);
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .cycle-step .num {
    background: var(--accent);
    color: white;
    border-radius: 50%;
    width: 20px;
    height: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.7rem;
    font-weight: 700;
    flex-shrink: 0;
  }

  /* QUIZ SECTION */
  .quiz-controls {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 20px;
    align-items: center;
  }

  .filter-btn {
    padding: 7px 16px;
    border-radius: 20px;
    border: 1px solid var(--border);
    background: var(--card);
    color: var(--muted);
    font-size: 0.8rem;
    cursor: pointer;
    transition: all 0.2s;
    font-family: 'DM Sans', sans-serif;
  }

  .filter-btn:hover { border-color: var(--gold); color: var(--gold); }
  .filter-btn.active { background: var(--gold); color: #000; border-color: var(--gold); font-weight: 600; }

  .question-card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 20px;
    margin-bottom: 14px;
    transition: border-color 0.2s;
  }

  .question-card.answered-correct { border-color: var(--green); background: rgba(61,220,132,0.05); }
  .question-card.answered-wrong { border-color: var(--red); background: rgba(255,95,109,0.05); }

  .q-meta {
    display: flex;
    gap: 10px;
    align-items: center;
    margin-bottom: 12px;
    flex-wrap: wrap;
  }

  .q-num {
    font-family: 'DM Mono', monospace;
    font-size: 0.75rem;
    color: var(--muted);
  }

  .q-tag {
    font-size: 0.7rem;
    padding: 2px 8px;
    border-radius: 10px;
    font-weight: 500;
  }

  .q-tag.mcq { background: rgba(91,141,238,0.15); color: var(--blue); border: 1px solid rgba(91,141,238,0.3); }
  .q-tag.short { background: rgba(61,220,132,0.12); color: var(--green); border: 1px solid rgba(61,220,132,0.25); }
  .q-tag.def { background: rgba(245,200,66,0.12); color: var(--gold); border: 1px solid rgba(245,200,66,0.25); }

  .q-text {
    font-size: 0.92rem;
    font-weight: 500;
    color: var(--text);
    margin-bottom: 14px;
    line-height: 1.6;
  }

  /* MCQ Options */
  .mcq-options {
    display: grid;
    gap: 8px;
  }

  .mcq-opt {
    padding: 10px 14px;
    border: 1px solid var(--border);
    border-radius: 8px;
    cursor: pointer;
    font-size: 0.875rem;
    color: var(--text);
    background: var(--surface);
    transition: all 0.2s;
    text-align: left;
    font-family: 'DM Sans', sans-serif;
    line-height: 1.4;
  }

  .mcq-opt:hover:not(:disabled) { border-color: var(--gold); color: var(--gold); }
  .mcq-opt.correct { border-color: var(--green); background: rgba(61,220,132,0.12); color: var(--green); font-weight: 600; }
  .mcq-opt.wrong { border-color: var(--red); background: rgba(255,95,109,0.12); color: var(--red); }
  .mcq-opt:disabled { cursor: not-allowed; opacity: 0.75; }

  /* Short Q input */
  .short-input-area {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .ans-input {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 12px 14px;
    color: var(--text);
    font-size: 0.875rem;
    font-family: 'DM Sans', sans-serif;
    resize: vertical;
    min-height: 80px;
    transition: border-color 0.2s;
  }

  .ans-input:focus { outline: none; border-color: var(--gold); }
  .ans-input:disabled { opacity: 0.6; cursor: not-allowed; }

  .submit-btn {
    align-self: flex-start;
    padding: 9px 22px;
    background: var(--gold);
    color: #000;
    border: none;
    border-radius: 8px;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    font-family: 'DM Sans', sans-serif;
    transition: opacity 0.2s;
  }

  .submit-btn:hover:not(:disabled) { opacity: 0.88; }
  .submit-btn:disabled { opacity: 0.5; cursor: not-allowed; }

  /* Feedback */
  .feedback {
    display: none;
    margin-top: 12px;
    padding: 12px 14px;
    border-radius: 8px;
    font-size: 0.85rem;
    line-height: 1.65;
  }

  .feedback.correct {
    background: rgba(61,220,132,0.1);
    border: 1px solid rgba(61,220,132,0.3);
    color: var(--green);
    display: block;
  }

  .feedback.wrong {
    background: rgba(255,95,109,0.1);
    border: 1px solid rgba(255,95,109,0.3);
    color: var(--red);
    display: block;
  }

  .feedback .model-ans {
    color: var(--text);
    margin-top: 8px;
    padding-top: 8px;
    border-top: 1px solid rgba(255,255,255,0.1);
  }

  .feedback .model-ans strong { color: var(--gold); }

  /* PROGRESS */
  .progress-section {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 20px;
    margin-bottom: 20px;
    text-align: center;
  }

  .big-score {
    font-family: 'Playfair Display', serif;
    font-size: 3.5rem;
    color: var(--gold);
    line-height: 1;
  }

  .progress-bar {
    height: 8px;
    background: var(--border);
    border-radius: 4px;
    margin: 16px 0 10px;
    overflow: hidden;
  }

  .progress-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--gold), #f0a500);
    border-radius: 4px;
    transition: width 0.5s ease;
  }

  .stats-row {
    display: flex;
    justify-content: center;
    gap: 24px;
    font-size: 0.85rem;
  }

  .stat { color: var(--muted); }
  .stat span { font-weight: 600; display: block; font-size: 1.1rem; }
  .stat .g { color: var(--green); }
  .stat .r { color: var(--red); }
  .stat .y { color: var(--gold); }

  .reset-btn {
    margin-top: 16px;
    padding: 9px 22px;
    background: transparent;
    color: var(--muted);
    border: 1px solid var(--border);
    border-radius: 8px;
    font-size: 0.8rem;
    cursor: pointer;
    font-family: 'DM Sans', sans-serif;
    transition: all 0.2s;
  }

  .reset-btn:hover { border-color: var(--red); color: var(--red); }

  /* Search */
  .search-bar {
    width: 100%;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 12px 16px;
    color: var(--text);
    font-size: 0.9rem;
    font-family: 'DM Sans', sans-serif;
    margin-bottom: 16px;
    transition: border-color 0.2s;
  }

  .search-bar:focus { outline: none; border-color: var(--gold); }

  .no-results {
    text-align: center;
    color: var(--muted);
    padding: 40px 0;
    font-size: 0.9rem;
  }

  /* Scrollbar */
  ::-webkit-scrollbar { width: 6px; }
  ::-webkit-scrollbar-track { background: var(--bg); }
  ::-webkit-scrollbar-thumb { background: var(--border); border-radius: 3px; }

  /* Category badge */
  .cat-header {
    font-family: 'DM Mono', monospace;
    font-size: 0.7rem;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 2px;
    margin: 24px 0 10px;
    padding-bottom: 6px;
    border-bottom: 1px solid var(--border);
  }

  .section-label {
    font-size: 0.75rem;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 1.5px;
    margin-bottom: 14px;
  }
</style>
</head>
